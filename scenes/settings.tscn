[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/screens/settings.gd" id="1_set"]
[ext_resource type="PackedScene" path="res://scenes/components/background.tscn" id="2_bg"]
[ext_resource type="Script" path="res://scripts/ui/retro_menu.gd" id="3_menu"]
[ext_resource type="Script" path="res://scripts/ui/retro_stepper.gd" id="4_step"]
[ext_resource type="Script" path="res://scripts/ui/retro_button.gd" id="5_btn"]

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_set")

[node name="Background" parent="." instance=ExtResource("2_bg")]

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0
alignment = 1

[node name="Header" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "SETTINGS"
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Content"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
mouse_filter = 2

[node name="Menu" type="VBoxContainer" parent="Content"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 4
script = ExtResource("3_menu")

[node name="VolumeOption" type="Button" parent="Content/Menu"]
custom_minimum_size = Vector2(400, 24)
layout_mode = 2
text = "VOLUME"
script = ExtResource("4_step")

[node name="FullscreenOption" type="Button" parent="Content/Menu"]
custom_minimum_size = Vector2(400, 24)
layout_mode = 2
text = "FULLSCREEN"
script = ExtResource("4_step")

[node name="CrtOption" type="Button" parent="Content/Menu"]
custom_minimum_size = Vector2(400, 24)
layout_mode = 2
text = "CRT FILTER"
script = ExtResource("4_step")

[node name="BackButton" type="Button" parent="Content/Menu"]
custom_minimum_size = Vector2(400, 24)
layout_mode = 2
text = "BACK"
script = ExtResource("5_btn")
press_sfx = "back"

[node name="Gap2" type="Control" parent="Content"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
mouse_filter = 2

[node name="Hint" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "LEFT/RIGHT: CHANGE   ESC: BACK   F11: FULLSCREEN"
horizontal_alignment = 1
