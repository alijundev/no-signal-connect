[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/screens/win_screen.gd" id="1_win"]
[ext_resource type="PackedScene" path="res://scenes/components/background.tscn" id="2_bg"]
[ext_resource type="Script" uid="uid://dhjvqg405bf4h" path="res://scripts/ui/pixel_title.gd" id="3_title"]
[ext_resource type="Script" uid="uid://cbhwudwagpeym" path="res://scripts/ui/retro_menu.gd" id="4_menu"]
[ext_resource type="Script" uid="uid://bqspgtnijlaq" path="res://scripts/ui/retro_button.gd" id="5_btn"]

[node name="WinScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_win")

[node name="Background" parent="." instance=ExtResource("2_bg")]

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0
alignment = 1

[node name="Title" type="Control" parent="Content"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
mouse_filter = 2
script = ExtResource("3_title")
text = "CONNECTED!"
font_size = 28
second_part = "CONNECTED"

[node name="Subtitle" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "ALLEN & LUNA MADE IT HOME"
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Content"]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
mouse_filter = 2

[node name="Menu" type="VBoxContainer" parent="Content"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 8
script = ExtResource("4_menu")

[node name="PlayAgainButton" type="Button" parent="Content/Menu"]
layout_mode = 2
text = "PLAY AGAIN"
script = ExtResource("5_btn")
press_sfx = "start"

[node name="MainMenuButton" type="Button" parent="Content/Menu"]
layout_mode = 2
text = "MAIN MENU"
script = ExtResource("5_btn")
press_sfx = "back"
